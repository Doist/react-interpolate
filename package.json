{
    "name": "@todoist/react-interpolate",
    "version": "2.2.5",
    "repository": "https://github.com/todoist/react-interpolate",
    "license": "MIT",
    "description": "A string interpolation component that formats and interpolates a template string in a safe way",
    "main": "dist/react-interpolate.cjs",
    "module": "dist/react-interpolate.mjs",
    "types": "dist/react-interpolate.d.ts",
    "engines": {
        "node": "^20.0.0 || ^22.0.0 || ^24.0.0 || ^26.0.0",
        "npm": "^10.0.0 || ^11.0.0 || ^12.0.0"
    },
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "test": "jest",
        "lint": "eslint ./src ./__test__",
        "build": "del dist && rollup -c && npm run mini-cjs && npm run mini-mjs",
        "mini-cjs": "uglifyjs dist/react-interpolate.cjs --compress --mangle --enclose --output  dist/react-interpolate.min.cjs",
        "mini-mjs": "uglifyjs dist/react-interpolate.mjs --compress --mangle --enclose --output dist/react-interpolate.min.mjs",
        "prettify": "prettier --write .",
        "prepublishOnly": "node -e \"throw new Error('Use the reviewed retained-artifact publisher; see docs/releasing.md')\"",
        "test:release": "node --test .github/scripts/*.test.mjs",
        "test:package": "node .github/scripts/consumer-check.mjs"
    },
    "prettier": "@todoist/prettier-config",
    "keywords": [
        "react",
        "interpolate",
        "template",
        "format",
        "text",
        "string"
    ],
    "peerDependencies": {
        "prop-types": "15.8.1",
        "react": ">=17.0.2",
        "react-dom": ">=17.0.2"
    },
    "dependencies": {
        "@babel/runtime": "7.18.6"
    },
    "devDependencies": {
        "@babel/cli": "7.18.6",
        "@babel/core": "7.29.6",
        "@babel/eslint-parser": "7.18.2",
        "@babel/plugin-transform-runtime": "7.18.6",
        "@babel/preset-env": "7.18.6",
        "@babel/preset-react": "7.18.6",
        "@todoist/eslint-config": "13.1.2",
        "@todoist/prettier-config": "4.0.2",
        "@semantic-release/changelog": "6.0.3",
        "@semantic-release/git": "10.0.1",
        "@testing-library/react": "13.3.0",
        "babel-jest": "28.1.2",
        "conventional-changelog-conventionalcommits": "9.3.1",
        "core-js": "3.23.3",
        "del-cli": "4.0.1",
        "eslint": "8.57.1",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-compat": "4.0.2",
        "eslint-plugin-import": "2.32.0",
        "eslint-plugin-jest": "26.5.3",
        "eslint-plugin-prettier": "5.5.4",
        "eslint-plugin-react": "7.37.5",
        "eslint-plugin-react-hooks": "7.0.1",
        "gzip-cli": "1.2.0",
        "jest": "28.1.2",
        "jest-environment-jsdom": "28.1.2",
        "prettier": "3.6.2",
        "react": "18.2.0",
        "react-dom": "18.2.0",
        "rollup": "2.80.0",
        "rollup-plugin-babel": "4.4.0",
        "rollup-plugin-copy": "3.5.0",
        "semantic-release": "25.0.5",
        "uglify-es": "3.3.9"
    }
}
